APP_NAME=Football Edge Bot
ENV=development
LOG_LEVEL=INFO

# Database. Clever Cloud can expose POSTGRESQL_ADDON_URI.
DATABASE_URL=
POSTGRESQL_ADDON_URI=

# API-Football
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
FOOTBALL_SEASON=2026
TRACKED_LEAGUES=39,140,135,78,61

# The Odds API
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
ODDS_ENABLED=false
ODDS_SPORT_KEY=soccer_epl
ODDS_REGIONS=eu
ODDS_MARKETS=h2h,totals
ODDS_BOOKMAKERS=

# Optional local Ollama for news/text feature extraction.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_ENABLED=false

# Paper trading / risk
PAPER_TRADING=true
INITIAL_BANKROLL=1000
MIN_EDGE=0.04
MAX_STAKE_PCT=0.005
KELLY_FRACTION=0.25
MAX_DAILY_BETS=10
MAX_OPEN_EXPOSURE_PCT=0.03

# Polling
POLL_SECONDS=900
MAX_LIVE_FIXTURES=20
ODDS_CALLS_PER_DAY_CAP=10

# Admin endpoint protection
ADMIN_TOKEN=change-me

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
